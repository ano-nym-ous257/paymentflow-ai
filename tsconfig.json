{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@paymentflow/ui/*": ["packages/ui/src/*"],
      "@paymentflow/shared-types": ["packages/shared-types/src/index.ts"],
      "@paymentflow/shared-utils": ["packages/shared-utils/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "**/dist", "**/*.spec.ts", "**/*.test.ts"]
}
